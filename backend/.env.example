# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=neuralagent
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Alternative full connection string (overrides above if set)
DB_CONNECTION_STRING=

# SQL/Engine settings
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# JWT
JWT_ISS=NeuralAgentBackend
JWT_SECRET=CHANGE_ME

# Redis (optional)
REDIS_CONNECTION=

# Providers (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-west-2

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-12-01-preview

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

GOOGLE_API_KEY=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434

# Agent model config per agent
CLASSIFIER_AGENT_MODEL_TYPE=openai
CLASSIFIER_AGENT_MODEL_ID=gpt-4.1

TITLE_AGENT_MODEL_TYPE=openai
TITLE_AGENT_MODEL_ID=gpt-4.1-nano

SUGGESTOR_AGENT_MODEL_TYPE=openai
SUGGESTOR_AGENT_MODEL_ID=gpt-4.1-mini

PLANNER_AGENT_MODEL_TYPE=openai
PLANNER_AGENT_MODEL_ID=gpt-4.1

COMPUTER_USE_AGENT_MODEL_TYPE=anthropic
COMPUTER_USE_AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

SUMMARIZER_AGENT_MODEL_TYPE=openai
SUMMARIZER_AGENT_MODEL_ID=gpt-4.1-mini

# Internal training logging (off by default)
ENABLE_SCREENSHOT_LOGGING_FOR_TRAINING=false
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Google Login (optional)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_DESKTOP_REDIRECT_URI=http://127.0.0.1:36478

# CORS
# Comma-separated list of allowed origins. If empty, defaults to local Electron dev address.
ALLOWED_ORIGINS=